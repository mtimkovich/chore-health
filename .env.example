# Copy this file to .env and fill in real values - .env is gitignored so it
# never gets committed. Used by docker-compose.yml.

# Leave empty (or omit the line) to run without a login screen.
CHORE_HEALTH_PASSWORD=

# IANA timezone name, e.g. America/New_York. Leave empty to default to UTC,
# which breaks the "reappears at local midnight" logic for recurring chores.
TZ=
